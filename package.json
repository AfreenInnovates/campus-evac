{
  "name": "campusevac",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "env:pull": "node -e \"const {execSync}=require('child_process');const outputs=JSON.parse(execSync('aws cloudformation describe-stacks --stack-name CampusEvacStack --output json')).Stacks[0].Outputs;const v=Object.fromEntries(outputs.map(o=>[o.OutputKey,o.OutputValue]));require('fs').writeFileSync('.env.local','NEXT_PUBLIC_EVENTS_HTTP_HOST='+v.HttpHost+'\\nNEXT_PUBLIC_EVENTS_REALTIME_URL='+v.RealtimeEndpoint+'\\nNEXT_PUBLIC_EVENTS_API_KEY='+v.ApiKey+'\\n');console.log('.env.local written from CampusEvacStack outputs')\"",
    "infra:install": "npm --prefix infra ci",
    "infra:bootstrap": "npm --prefix infra run bootstrap",
    "infra:synth": "npm --prefix infra run synth",
    "infra:deploy": "npm --prefix infra run deploy",
    "voice": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/synth-voice.mts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.958.0",
    "@aws-sdk/client-dynamodb": "^3.1136.0",
    "@aws-sdk/client-sesv2": "^3.1136.0",
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.3",
    "@react-three/rapier": "^2.2.0",
    "next": "16.3.4",
    "postprocessing": "^6.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@aws-sdk/client-polly": "^3.1135.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
