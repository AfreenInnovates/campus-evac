# CampusEvac environment. Template - copy to .env and fill in the blanks. Never commit real values.

# --- Crowd Lab AI (Nemotron via Nebius Token Factory) ---------------------------
# Key from https://tokenfactory.nebius.com. Required for the Crowd Lab agents.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Password for training the shared warden playbook. Everyone on the team uses the same one,
# and Vercel must have the same value. Leave empty to let anyone train.
WARDEN_ADMIN_KEY=

# --- AWS (Polly voice, SES email, DynamoDB) ---------------------------------------
# Locally: sign in with the AWS CLI (aws configure / aws sso login) and leave these commented.
# On Vercel, or without the CLI: uncomment and use an IAM user with infra/runtime-policy.json.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
POLLY_REGION=ap-south-1
SES_REGION=ap-south-1
# DynamoDB table for reports and the warden playbook (created by the CDK stack).
REPORTS_TABLE=campusevac-events
# Must be an SES-verified identity in SES_REGION. Empty = drill reports are not emailed.
REPORT_FROM_EMAIL=afreenhossain0000@gmail.com

# --- Multiplayer drill rooms (AppSync Events, from the CDK stack) -------------------
# Fill with `npm run env:pull`, or copy HttpHost, RealtimeEndpoint and ApiKey from
# CloudFormation > CampusEvacStack > Outputs. Empty = rooms are switched off.
NEXT_PUBLIC_EVENTS_HTTP_HOST=
NEXT_PUBLIC_EVENTS_REALTIME_URL=
NEXT_PUBLIC_EVENTS_API_KEY=
